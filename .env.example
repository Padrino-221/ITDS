# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itds?schema=public"

# Secret used to sign session cookies (required in production).
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical origin used by the sitemap and JSON-LD structured data.
# Defaults to https://itdsuenr.com when unset.
NEXT_PUBLIC_SITE_URL="https://itdsuenr.com"

# Canonical origin of the E-Learning Hub, used by the site nav, the sitemap
# and JSON-LD. Defaults to https://learn.itdsuenr.com when unset.
#
# Before the domain is transferred you can serve the hub from the deployment's
# public URL instead: point both to the same host with LEARN at the /learn
# path (subdomain-based host routing in src/proxy.ts is then disabled and the
# learn app is served natively at /learn):
#   NEXT_PUBLIC_SITE_URL="https://my-app.vercel.app"
#   NEXT_PUBLIC_LEARN_URL="https://my-app.vercel.app/learn"
NEXT_PUBLIC_LEARN_URL="https://learn.itdsuenr.com"

# Resend API key â€” enables newsletter welcome emails (optional).
RESEND_API_KEY=""
# Verified sender for newsletter emails (optional).
RESEND_EMAIL_FROM="ITDS Newsletter <onboarding@resend.dev>"

# Wandbox code-execution endpoint for CODE exam questions (optional).
# When unreachable, CODE answers are excluded from the exam score.
# API: https://github.com/melpon/wandbox/blob/master/kennel2/API.rst
WANDBOX_URL=""

