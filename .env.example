# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itds?schema=public"

# Secret used to sign session cookies (required in production).
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical origin used by the sitemap and JSON-LD structured data.
# Defaults to https://itdsuenr.com when unset.
NEXT_PUBLIC_SITE_URL="https://itdsuenr.com"

# Canonical origin of the /learn subdomain, used by the site nav, the
# sitemap and JSON-LD. Defaults to https://learn.itdsuenr.com when unset.
NEXT_PUBLIC_LEARN_URL="https://learn.itdsuenr.com"

# Resend API key — enables newsletter welcome emails (optional).
RESEND_API_KEY=""
# Verified sender for newsletter emails (optional).
RESEND_EMAIL_FROM="ITDS Newsletter <onboarding@resend.dev>"
