generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DegreeLevel {
  UNDERGRADUATE
  DIPLOMA
  MSC
  MPHIL
  PHD
}

model Program {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  degreeLevel         DegreeLevel @unique
  overview            String   @default("")
  learningObjectives  String   @default("")
  curriculumStructure String   @default("")
  programmeContact    String   @default("")
  published          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
  LECTURER
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            Role     @default(EDITOR)
  createdAt       DateTime @default(now())
  authoredLessons Lesson[] @relation("AuthoredLessons")
  reviewedLessons Lesson[] @relation("ReviewedLessons")
  passwordResets  PasswordReset[]
}

/**
 * Learner accounts for the E-Learning Hub (/learn). Deliberately separate
 * from the staff `User` table — learners self-register and must never be able
 * to sign in to the Staff Panel, and staff accounts must never count as
 * learners. Sessions use their own cookie (see src/lib/learn-auth.ts).
 */
model Learner {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  progress     UserProgress[]
}

model NewsPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  image       String?
  category    String   @default("General")
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lecturer {
  id                String      @id @default(cuid())
  slug              String      @unique
  name              String
  title             String
  photo             String?
  bio               String?
  email             String?
  researchInterests String?
  order             Int         @default(0)
  createdAt         DateTime    @default(now())
  projects          Project[]
  supervisor        Supervisor?
}

model Project {
  id           String      @id @default(cuid())
  slug         String      @unique
  title        String
  abstract     String?
  studentName  String?
  program      String?
  degreeLevel  DegreeLevel @default(UNDERGRADUATE)
  academicYear String?
  image        String?
  supervisorId String?
  supervisor   Lecturer?   @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  published    Boolean     @default(true)
  // SPMS fields
  documentUrl  String?     // Path to uploaded PDF (/uploads/...)
  documentName String?     // Original filename for display
  objective    String?     // Project main objective
  groupMembers String?     // Group member names
  githubLink   String?     // GitHub repository URL
  createdAt    DateTime    @default(now())
}

model ResearchArea {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  image       String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model GalleryImage {
  id      String  @id @default(cuid())
  src     String
  caption String?
  order   Int     @default(0)
}

model Setting {
  key   String @id
  value String
}

// ---------------------------------------------------------------------------
// SPMS Password Resets
// ---------------------------------------------------------------------------

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// SPMS — fully separate from the staff panel
// ---------------------------------------------------------------------------

model Supervisor {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("LECTURER") // LECTURER or ADMIN
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Profile fields
  userTitle     String?  // Mr., Mrs., Ms., Dr., Prof.
  gender        String?  // Male, Female
  jobRank       String?  // Research Assistant, Lecturer, etc.
  phone         String?
  linkedin      String?
  facebook      String?
  twitter       String?  // Publication link 1
  publink       String?  // Publication link 2
  profilePhoto  String?  // Upload URL
  researchArea1 String?
  researchArea2 String?
  about         String?  // Bio / about text

  // Link to public Lecturer profile
  lecturerId    String?   @unique
  lecturer      Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  // Relations
  passwordResets SupervisorPasswordReset[]
}

model SupervisorPasswordReset {
  id           String     @id @default(cuid())
  supervisorId String
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  token        String     @unique
  expiresAt    DateTime
  used         Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

// Uploaded image files. Named with unique timestamps, so the name doubles as
// a public cache key (see /uploads/[path]/route.ts). Stored in Postgres —
// Vercel serverless runs have an ephemeral read-only filesystem, so the old
// on-disk uploads/ directory could not survive between requests there.
model Upload {
  id          String   @id @default(cuid())
  name        String   @unique
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// E-Learning platform (/learn)
// ---------------------------------------------------------------------------

enum LessonStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  PUBLISHED
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  topics      Topic[]
  createdAt   DateTime @default(now())
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  slug      String
  order     Int      @default(0)
  lessons   Lesson[]

  @@unique([subjectId, slug])
}

model Lesson {
  id              String       @id @default(cuid())
  topicId         String
  topic           Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  objective       String       @default("")
  contentBody     Json         @default("{}") // rich text / structured content
  hasPlayground   Boolean      @default(false)
  playgroundLang  String?
  starterCode     String?
  exercisePrompt  String?
  quiz            Json?        // optional check-for-understanding
  status          LessonStatus @default(DRAFT)
  authorId        String
  author          User         @relation("AuthoredLessons", fields: [authorId], references: [id])
  reviewerId      String?
  reviewer        User?        @relation("ReviewedLessons", fields: [reviewerId], references: [id])
  reviewNote      String?
  // Snapshot of the last PUBLISHED version, so authors can revise a live
  // lesson without mutating it (spec §5.5).
  publishedSnapshot Json?
  progress        UserProgress[]
  order           Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([topicId, slug])
}

model UserProgress {
  id             String    @id @default(cuid())
  learnerId      String
  learner        Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed      Boolean   @default(false)
  completedAt    DateTime?
  // Quiz best score tracking (one row per learner+lesson, best score kept).
  bestScore      Int?
  bestScoreTotal Int?
  attemptCount   Int       @default(0)
  lastAttemptAt  DateTime?

  @@unique([learnerId, lessonId])
}
